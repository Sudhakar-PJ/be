# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (Neon or Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db?sslmode=disable
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (Upstash or Local Redis)
REDIS_URL=redis://localhost:6379

# JWT Asymmetric RS256 Keys (Base64-encoded PEM strings)
# For local dev, you can use temporary mock keys or generate a pair with ssh-keygen
JWT_ACCESS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0u9...\n-----END RSA PRIVATE KEY-----"
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0B...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
